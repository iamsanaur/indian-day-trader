# Copy to .env (git-ignored, chmod 600).
# Dhan login: client ID + 6-digit PIN here; enter the TOTP from your authenticator once a day in the app
# (Settings › Dhan session) or with `idt dhan login`. TOTP must be enabled at web.dhan.co › DhanHQ Trading APIs.
DHAN_CLIENT_ID=
DHAN_PIN=
# Optional manual override: a token generated on web.dhan.co (skips TOTP login while set)
DHAN_ACCESS_TOKEN=
# Public URL phones pair with (the Cloudflare tunnel hostname)
IDT_PUBLIC_URL=https://daytrader.example.com
